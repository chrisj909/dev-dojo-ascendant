# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Neon Postgres
# ---------------------------------------------------------------------------
# Neon dashboard -> your project -> Connection Details -> Connection string.
#
# DATABASE_URL is the POOLED endpoint. Its host contains "-pooler". This is what
# request traffic uses, and it is what you set in Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED is the DIRECT endpoint — the same string with "-pooler"
# removed from the host. Migrations, role creation and DDL run here, because
# Neon's pooled endpoint is PgBouncer in transaction mode and is not a reliable
# place to run schema changes.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=""

# GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
#
# One OAuth app holds exactly ONE callback URL, so local and production need
# SEPARATE apps. Production is https://dojo.progrowthtech.com with callback
# https://dojo.progrowthtech.com/api/auth/callback/github — see D9 in
# docs/DECISIONS.md. Or skip all of this locally and use AUTH_DEV_LOGIN below.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Production only. Pins the host that callbacks are built against, so a visitor
# arriving on the .vercel.app domain still lands on the one registered callback
# URL. Leave blank locally — Auth.js infers localhost correctly.
# AUTH_URL="https://dojo.progrowthtech.com"

# Set to 1 to enable the password-free local sign-in button, so you can run the
# game without registering an OAuth app. Refused in production regardless.
AUTH_DEV_LOGIN="1"

# ---------------------------------------------------------------------------
# Tests (optional)
# ---------------------------------------------------------------------------
# The integration suite proves the RLS policies actually deny cross-tenant
# access (SPEC §7 test 12). Leave TEST_DATABASE_URL unset and it runs against an
# in-process Postgres (PGlite) with no setup at all.
#
# Set it to run the same suite against real Neon instead — higher fidelity, and
# the only way to confirm YOUR database is configured correctly. Point it at a
# THROWAWAY Neon branch: the suite truncates tables between tests.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
